{
  "mcpServers": {
    "serena-mcp": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd"
      ]
    },
    "cocoindex-code": {
      "type": "stdio",
      "command": "cocoindex-code",
      "args": [
        "serve"
      ]
    },
    "codegraph-mcp": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
