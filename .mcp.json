{
  "mcpServers": {
    "serena-mcp": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server"
      ]
    },
    "cocoindex-code": {
      "type": "stdio",
      "command": "ccc",
      "args": [
        "mcp"
      ]
    },
    "codegraph-mcp": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
