# default: ignore all files
*

# Allow directories, so git descends into them
!*/

# Deny build artifacts & dependencies (must come after `!*/`)
.blume/
.blume-verify/
dist/
node_modules/

# Allow git settings
!**/.gitignore

# Allow sources & configs
!**/*.ts
!**/*.mts
!**/*.js
!**/*.mjs
!**/*.json
!**/*.yaml
!**/*.yml
!**/*.toml

# Allow contents
!**/*.md
!**/*.mdx
!**/*.astro
!**/*.css
!**/*.svg
!**/*.png
!**/*.jpg
!**/*.webp
!**/*.ico

# Allow public assets (extension-less dotfiles such as .nojekyll)
!/public/**

# Allow README, LICENSE, CONTRIBUTING
!**/README*
!**/LICENSE*
!**/CONTRIBUTING*

# Allow AI agent docs & editor settings
!**/AGENTS.md
!**/CLAUDE*.md
!**/.editorconfig
