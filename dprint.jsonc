{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // Global settings
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  // Include/Exclude patterns
  "includes": [
    // Programming Languages
    "**/*.js",
    "**/*.ts",
    // Configurations
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    // Other Configurations
    "**/*.dic",
    // Documents
    // NOTE: The markdown plugin does not support MDX. It rewrites JSX expression
    //       attributes (cols={2}) into strings ("{2}"). In *.mdx, write component
    //       attributes as string literals (cols="2").
    "**/*.md",
    "**/*.mdx",
  ],
  "excludes": [
    // node, etc
    "**/node_modules/**",
    "**/lib/**",
    "**/module/**",
    "**/dist/**",
    // ignore blume files
    "aglabo.github.io/.blume/**",
    "aglabo.github.io/.blume-verify/**",
    "aglabo.github.io/node_modules/**",
    "aglabo.github.io/dist/**",
    // package managers lock files
    "**/deno.lock",
    "**/pnpm-lock.yaml",
    // test fixtures
    // If dprint normalizes their bytes, edge-case fixtures that test blank lines,
    // trailing newlines, and line endings become useless. (markdownlint already
    // excludes **/__tests__/**, and textlint excludes **/fixtures/**.)
    // .ts specs and helpers are still formatted.
    "**/fixtures-data/**",
    "**/fixtures/**/*.md",
    "**/fixtures/**/*.yaml",
    "**/fixtures/**/*.json",
    "**/fixtures/**/*.dic",
    // Documents
    "CONTRIBUTING**.md",
    "CODE_OF_CONDUCT**.md",
  ],
  // Plugins
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/toml@0.9.0",
  ],
  // Language-specific settings
  "typescript": {
    "indentWidth": 2,
    "useTabs": false,
    "quoteStyle": "preferSingle",
    "preferSingleLine": false,
    "useBraces": "always",
    "arrowFunction.useParentheses": "force",
    "trailingCommas": "onlyMultiLine",
  },
  "json": {},
  "markdown": {
    "associations": [
      "**/*.md",
      "**/*.mdx",
    ],
    "emphasisKind": "asterisks",
  },
  "yaml": {
    "associations": [
      "**/*.dic"
    ],
  },
}
