# default: ignore all files
*

# Allow README, LICENSE, CONTRIBUTING
!**/README*
!**/LICENSE*
!**/CONTRIBUTING*

# Allow .github directories
!.github/
!.github/**

# Allow other ignore
!*ignore

# Allow editorconfig
!**/.editorconfig

# Allow settings
!**/settings.json

## Root configs
!**/package.json
!**/pnpm-lock.yaml
!/renovate.json
!/lefthook.yml
!/dprint.jsonc
!/.shellspec
!/.mcp.json
!/mise.toml

# ChangeLog
!**/CHANGELOG.md
!**/Release-Note.md

# deno
!/deno.json
!/deno.lock

## .env
.env
.env.*
!.env.example

## Config
# chatlog-exporter configs (source tree consumed by scripts/sync-skill-assets.sh)
!/.config/
!/.config/chatlog-exporter/
!/.config/chatlog-exporter/**

# config files
!/configs/
!/configs/**
!/configs/**/*.json
!/configs/**/*.yml
!/configs/**/*.yaml
!/configs/**/*.toml
!/configs/**/*rc
!/configs/**/*.js
!/configs/**/*.mjs

# runners & scripts
!/runners
!/runners/**
!/runners/**/*.sh
!/scripts
!/scripts/**
!/scripts/**/*.sh
!/scripts/**/*.ts

## AI Agents
# codex, etc
!**/AGENTS.md

# claude code
!**/CLAUDE*.md

# allowlist details: .claude/.gitignore
!.claude/
!**/CLAUDE*.md
!.claude/agents/
!.claude/agents/**
!.claude/agents/**/*.md
!.claude/hooks/
!.claude/hooks/**
!.claude/hooks/**/*.sh
!.claude/rules/
!.claude/rules/**
!.claude/rules/**/*.md
!.claude/skills/
!.claude/skills/**
!.claude/skills/**/*.md
!.claude/skills/**/*.ts

# for IDD lib
!.claude/commands/
!.claude/commands/**
!.claude/commands/**/*.sh

##  Editor
#   VSCode
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*
!.vscode/cspell*/**



## beads
!.beads/
!.beads/config.yaml
!.beads/issues.jsonl

# WebSite
# contents are allowlisted by aglabo.github.io/.gitignore.
# NOTE: the directory line below must stay - root's `*` matches the directory
#       itself, and git would never descend to read the nested .gitignore.
!aglabo.github.io/

## Projects
# projects main
!skills/
!skills/**
!skills/**/*.md
!skills/**/*.ts

# projects docs
!docs
!docs/**
!docs/**/*.md


##  Git
# allow git settings
!/.git*

# allow all gitignore
!**/.gitignore

