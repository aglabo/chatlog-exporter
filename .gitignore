# Default deny all
*

## General
# Allow README, LICENSE, CONTRIBUTING
!**/README*
!**/LICENSE*
!**/CONTRIBUTING*

# Allow .github directories
!.github/
!.github/**

# Allow other ignore
!*ignore

# Allow editorconfig
!**/.editorconfig

# Allow settings
!**/settings.json
**/*.local.json

## Root configs
!**/package.json
!**/pnpm-lock.yaml
!**/renovate.json
!**/lefthook.yml
!**/dprint.jsonc
!**/.shellspec
!**/.mcp.json
!**/mise.toml
!**/CHANGELOG.*
!**/Release-Note.*

## Project directories
# config files
!configs/
!configs/**
!configs/**/*.json
!configs/**/*.yml
!configs/**/*.yaml
!configs/**/*.toml
!configs/**/*rc
!configs/**/*.js
!configs/**/*.mjs

# runners & scripts
!/runners
!/runners/**
!/runners/**/*.sh
!/scripts
!/scripts/**
!/scripts/**/*.sh
!/scripts/**/*.ts

## AI Agents
# General
!**/AGENT.md

# claude code
!**/CLAUDE*.md

# allowlist details: .claude/.gitignore
!.claude/
!**/CLAUDE*.md
!.claude/
!.claude/agents/
!.claude/agents/**
!.claude/rules/
!.claude/rules/**
!.claude/commands/
!.claude/commands/**

##  Editor
#   VSCode
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*
!.vscode/cspell*/**


##  Git
# allow all gitignore
!**/.gitignore
!**/.gitattribute


## Deny rules (keep last)
# default deny rules

#   OS specific files
.DS_Store
thumbs.db

#   logs, patches
**/*.log
**/*.diff
**/*.patch

#   history, cache
**/.history/
**/.cache/

#   backup/swap/temp
**/$~*
**/~*
**/*~
**/*.tmp
**/*.swp
**/*.lock

#   session files
**/*session.json
**/*session

#   .env files
**/.env*
!.env.example

#   API keys / credentials
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*apikey*
**/*api-key*
**/*api_key*

#   temporary directories
**/temp
**/tmp

#   node
**/node_modules/
**/.pnpm-store/

#   mutation testing artifacts (REQ-C-005)
#   must stay after the allowlist re-includes (!/scripts/**/*.ts)
**/*.mutation-*.ts
**/*.mutation-*.tsx
**/deno.mutation-*.json
